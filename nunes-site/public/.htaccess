# Nunes Auditores — configuração Apache (hospedagens como Hostinger, Locaweb, HostGator, KingHost)
# Requer mod_rewrite, mod_headers, mod_expires e mod_deflate (padrão na maioria das hospedagens).

Options -Indexes -MultiViews
ServerSignature Off
AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Força HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://nunesauditores.com.br%{REQUEST_URI} [L,R=301]

  # 2) Endereço único: sem "www" (evita conteúdo duplicado no Google)
  RewriteCond %{HTTP_HOST} ^www\.nunesauditores\.com\.br$ [NC]
  RewriteRule ^ https://nunesauditores.com.br%{REQUEST_URI} [L,R=301]

  # 3) Remove index.html dos endereços
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # 4) Bloqueia arquivos ocultos, exceto /.well-known/
  RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>

# Bloqueia arquivos que não devem ser públicos
<FilesMatch "\.(md|log|bak|sql|sh|ini|env|git.*|py|json\.dist|lock)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|png|webp|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/xml image/svg+xml application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest
AddType text/plain .txt
