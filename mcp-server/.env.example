# Copy to .env (or export in your shell / MCP client config). Never commit the real file.

# Same Google OAuth client as the web app, OR a separate "Desktop app" OAuth
# client — see docs/SETUP.md. Whichever you use, its authorized redirect URI
# must include http://127.0.0.1:53682/oauth/callback for `jarvis-authorize`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: override the Drive root folder name (default: "Jarvis").
JARVIS_ROOT_FOLDER_NAME=Jarvis
