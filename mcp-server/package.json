{
  "name": "@jarvis/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing Jarvis's client-memory tools (Drive-backed) to Claude Desktop/Code.",
  "type": "module",
  "bin": {
    "jarvis-mcp-server": "./dist/server.js",
    "jarvis-authorize": "./dist/authorize-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "authorize": "npm run build && node dist/authorize-cli.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@jarvis/core": "*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
